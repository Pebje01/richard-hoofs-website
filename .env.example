# Kopieer dit bestand naar .env en vul de waarden in

# Poort waarop de server draait (Coolify regelt de mapping naar 80/443)
PORT=3000

# Wachtwoord voor het beheerpaneel (/beheer)
ADMIN_PASSWORD=kies-een-sterk-wachtwoord

# Willekeurige geheime string voor sessies (minimaal 32 tekens)
SESSION_SECRET=verander-dit-naar-een-lange-willekeurige-string

# ── Git auto-sync ────────────────────────────────────────────────
# Zet op 'true' om elke CMS-save automatisch naar GitHub te pushen.
# Coolify detecteert de push en herbouwt/deployt de container.
# Laat 'false' in lokale dev als je niet elke wijziging wil committen.
GIT_AUTO_PUSH=false
GIT_BRANCH=main
GIT_AUTHOR_NAME=Dokter Richard CMS
GIT_AUTHOR_EMAIL=cms@dokterrichard.nl

# Voor de container heb je een SSH deploy key nodig met schrijfrechten
# op de GitHub repo. Mount die via Coolify als /root/.ssh/id_ed25519.
